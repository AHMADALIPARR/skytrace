{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://skytrace.local/schemas/reconstruction.schema.json",
 "title":"PhysicsReconstruction","type":"object","additionalProperties":false,
 "required":["schema_version","run_id","event_id","model","input_sha256","calibration_sha256","coordinate_frame","range_identifiable","speed_m_s","speed_lower95_m_s","speed_upper95_m_s","solver_version","status","reason_codes"],
 "properties":{"schema_version":{"const":"1.0.0"},"run_id":{"type":"string","minLength":1},"event_id":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"input_sha256":{"$ref":"#/$defs/sha"},"calibration_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha"}]},"coordinate_frame":{"enum":["ECEF","ENU","WGS84","UNKNOWN"]},"range_identifiable":{"type":"boolean"},"speed_m_s":{"type":["number","null"],"minimum":0},"speed_lower95_m_s":{"type":["number","null"],"minimum":0},"speed_upper95_m_s":{"type":["number","null"],"minimum":0},"solver_version":{"type":"string","minLength":1},"status":{"enum":["solved","indeterminate","invalid"]},"reason_codes":{"type":"array","items":{"type":"string","minLength":1}}},
 "$defs":{"sha":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
 "allOf":[{"if":{"properties":{"range_identifiable":{"const":false}}},"then":{"properties":{"speed_m_s":{"type":"null"},"speed_lower95_m_s":{"type":"null"},"speed_upper95_m_s":{"type":"null"}}}}]
}
