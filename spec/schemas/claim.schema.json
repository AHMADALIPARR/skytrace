{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://skytrace.local/schemas/claim.schema.json",
  "title":"ScientificClaim",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","claim_id","statement","claim_kind","evidence_sha256","assumptions","alternatives","falsifiers","model","uncertainty","status"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "claim_id":{"type":"string","pattern":"^ST-CL-[A-Z0-9]{8,32}$"},
    "statement":{"type":"string","minLength":10},
    "claim_kind":{"enum":["qualitative","quantitative","classification"]},
    "evidence_sha256":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/sha256"}},
    "assumptions":{"type":"array","items":{"type":"string","minLength":1}},
    "alternatives":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "falsifiers":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "model":{"type":"object","additionalProperties":false,"required":["name","version","code_sha256"],"properties":{"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"code_sha256":{"$ref":"#/$defs/sha256"}}},
    "uncertainty":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["value","unit","lower_95","upper_95","method"],"properties":{"value":{"type":"number"},"unit":{"type":"string","minLength":1},"lower_95":{"type":"number"},"upper_95":{"type":"number"},"method":{"type":"string","minLength":1}}}]},
    "status":{"enum":["unassessed","admitted","rejected","indeterminate"]}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}
