{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://skytrace.local/schemas/correlation.schema.json",
 "title":"KnownObjectCorrelation","type":"object","additionalProperties":false,
 "required":["schema_version","result_id","observation_id","candidate_id","candidate_class","control_sha256","matched_samples","total_samples","angular_residual_rad","time_residual_s","coverage_status","decision","limitations"],
